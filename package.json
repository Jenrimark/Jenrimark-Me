{
  "name": "jenrimark-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @jenrimark/web dev",
    "build": "pnpm --filter @jenrimark/web build",
    "test": "pnpm -r test",
    "server": "pnpm --filter @jenrimark/server go:run",
    "web": "pnpm --filter @jenrimark/web dev"
  },
  "pnpm": {
    "workspace": ["apps/*", "packages/*"]
  }
}
